---
// src/pages/projects.astro
// PRD 6.3 — Projects. P1: exactly 3 projects. P3: grouped by type.
// P6: external links where confirmed. P2/P4/P5/P7 remain blocked on owner
// content: descriptions and tech stacks are placeholder/empty, thumbnails are
// absent so ProjectCard omits the media block (.clinerules/03).

import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ui/ProjectCard.astro';
import { projects } from '../data/projects';

const byOrder = (a: (typeof projects)[number], b: (typeof projects)[number]) => a.order - b.order;

const professional = projects
  .filter((project) => project.type === 'professional')
  .sort(byOrder);

const personal = projects.filter((project) => project.type === 'personal').sort(byOrder);
---

<BaseLayout
  title="Projects — Gery Pratama"
  description="Selected software projects by Gery Pratama — professional client work and personal builds, with tech stacks and links."
>
  <div class="mx-auto max-w-3xl px-6 py-16">
    <h1 class="reveal-on-scroll text-3xl font-semibold tracking-tight">Projects</h1>
    <p class="reveal-on-scroll mt-4 max-w-2xl text-slate-600 dark:text-slate-400">
      A mix of client work and personal builds. Descriptions and tech stacks are
      being updated.
    </p>

    {/* Professional work — PRD P3 */}
    <section class="mt-14" aria-labelledby="professional-heading">
      <h2
        id="professional-heading"
        class="reveal-on-scroll text-xl font-semibold tracking-tight"
      >
        Professional work
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {
          professional.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              thumbnail={project.thumbnail}
              techStack={project.techStack}
              liveUrl={project.liveUrl}
              repoUrl={project.repoUrl}
            />
          ))
        }
      </div>
    </section>

    {/* Personal projects — PRD P3 */}
    <section class="mt-14" aria-labelledby="personal-heading">
      <h2 id="personal-heading" class="reveal-on-scroll text-xl font-semibold tracking-tight">
        Personal projects
      </h2>
      <div class="mt-6 grid gap-5 sm:grid-cols-2">
        {
          personal.map((project) => (
            <ProjectCard
              title={project.title}
              description={project.description}
              thumbnail={project.thumbnail}
              techStack={project.techStack}
              liveUrl={project.liveUrl}
              repoUrl={project.repoUrl}
            />
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>
