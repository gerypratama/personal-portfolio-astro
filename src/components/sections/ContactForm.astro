---
// src/components/sections/ContactForm.astro
// PRD 6.4 C1–C4 — formly.email form, Name/Email/Subject/Message, required
// fields with native client-side validation, honeypot spam trap.
//
// OPEN (C4 success state): formly.email is configured per domain and its
// post-submit redirect is only known once the endpoint is provisioned for the
// final domain (.clinerules/03 — still blocked). No success markup is invented
// ahead of that; the mechanism is decided in M5 when the endpoint exists.
// The form therefore never ships in this state — it is placeholder-actioned
// and flagged in memory-bank/Progress.md.

import Button from '../ui/Button.astro';

// TODO(M5): replace with the formly.email endpoint for the production domain.
const formAction = '[PLACEHOLDER — formly.email endpoint pending, see .clinerules/03-content-status.md]';

const fieldClasses =
  'mt-1 block w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-sm text-slate-900 ' +
  'placeholder:text-slate-400 focus:border-indigo-600 focus:ring-2 focus:ring-indigo-600/20 focus:outline-none ' +
  'dark:border-slate-800 dark:bg-slate-900 dark:text-slate-50 dark:placeholder:text-slate-500';
---

<form action={formAction} method="POST" class="mt-6 space-y-5">
  <div>
    <label for="name" class="text-sm font-medium">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      autocomplete="name"
      class={fieldClasses}
    />
  </div>

  <div>
    <label for="email" class="text-sm font-medium">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      autocomplete="email"
      class={fieldClasses}
    />
  </div>

  <div>
    <label for="subject" class="text-sm font-medium">Subject</label>
    <input
      type="text"
      id="subject"
      name="subject"
      required
      class={fieldClasses}
    />
  </div>

  <div>
    <label for="message" class="text-sm font-medium">Message</label>
    <textarea
      id="message"
      name="message"
      rows="5"
      required
      class={fieldClasses}></textarea>
  </div>

  {/* Honeypot — must stay hidden (Architecture Section 11) */}
  <input
    type="text"
    name="_gotcha"
    style="display: none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <Button type="submit">Send Message</Button>
</form>
