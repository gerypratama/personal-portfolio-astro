---
// src/components/layout/Header.astro
// PRD GL1 (nav), GL4 (CV download), GL2 (theme toggle).
//
// Responsive without a hamburger: four short labels wrap onto a second row on
// narrow viewports, which keeps the JS bundle free of a menu implementation
// (Architecture: vanilla JS only for theme toggle + scroll reveal).

import ThemeToggle from '../ui/ThemeToggle.astro';
import Button from '../ui/Button.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/projects', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);

// PRD GL4 — the link is wired now; the PDF itself is still-blocked content
// (see .clinerules/03-content-status.md) and lands in M5.
const cvHref = '/cv/gery-pratama-cv.pdf';
---

<header class="border-b border-slate-200 dark:border-slate-800">
  <div class="mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-4">
    <a
      href="/"
      class="text-sm font-semibold tracking-tight text-slate-900 dark:text-slate-50"
    >
      Gery Pratama
    </a>

    <nav aria-label="Main">
      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
        {
          navLinks.map(({ href, label }) => (
            <li>
              <a
                href={href}
                aria-current={isActive(href) ? 'page' : undefined}
                class:list={[
                  'underline-offset-4 transition-colors hover:text-slate-900 hover:underline dark:hover:text-slate-50',
                  isActive(href)
                    ? 'font-medium text-indigo-600 dark:text-indigo-400'
                    : 'text-slate-600 dark:text-slate-400',
                ]}
              >
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <Button variant="link" href={cvHref} download>CV</Button>
      <ThemeToggle />
    </div>
  </div>
</header>
